# Your Anthropic API key (https://console.anthropic.com). Alternatively run `ant auth login`.
ANTHROPIC_API_KEY=

# Optional: a Tavily API key (https://tavily.com). When set, the tutor's web
# search goes through Tavily instead of Claude's built-in web search.
# TAVILY_API_KEY=

# Optional overrides
# LUMINARY_MODEL=claude-opus-5
# LUMINARY_FALLBACKS=1        # server-side refusal fallbacks (set 0 to disable)
# LUMINARY_WEB_SEARCH=1      # let the tutor search the web (set 0 to disable)
# LUMINARY_SEARCH_PROVIDER=   # "tavily" or "anthropic" (default: tavily if TAVILY_API_KEY is set)
# LUMINARY_MOCK=1             # offline demo mode with canned responses, no API calls
# PORT=3000
# HOST=127.0.0.1
# LUMINARY_DATA=./data/db.json
